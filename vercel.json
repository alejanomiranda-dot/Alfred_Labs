{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/assistant.js": {
      "maxDuration": 180
    },
    "api/forge.js": {
      "maxDuration": 300,
      "includeFiles": "{server/forge-worker.mjs,experiments/alfred-forge/examples/arbol-vero-ale.scad}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
